# Copy to .env and fill in real values. NEVER commit .env.

# Runtime
ENV=development
# Fail closed by default. Set to 0 only for local experiments (ignored when ENV=production).
REQUIRE_AUTH=1

# API authentication (required for all /sms/* routes except /health)
API_KEY=replace-with-long-random-string

# SMS provider selection: way2sms (legacy scraper) | twilio (not implemented yet)
SMS_PROVIDER=way2sms

# Way2sms credentials — SERVER-SIDE ONLY. Never send these from clients.
WAY2SMS_USERNAME=
WAY2SMS_PASSWORD=
# Prefer HTTPS. Cleartext HTTP is refused unless ALLOW_INSECURE_SMS_HTTP=1.
WAY2SMS_BASE_URL=https://www.way2sms.com
ALLOW_INSECURE_SMS_HTTP=0
SMS_HTTP_TIMEOUT_SECONDS=15

# When adding Twilio later (do not fabricate values):
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=

# Optional hardening
# TRUSTED_HOSTS=api.example.com,localhost
# CORS_ORIGINS=https://app.example.com
# RATE_LIMIT_PER_MINUTE=30
